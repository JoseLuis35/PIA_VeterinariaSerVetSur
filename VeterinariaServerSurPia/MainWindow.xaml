<Window
    x:Class="VeterinariaServerSurPia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VeterinariaServerSurPia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <NavigationView
            x:Name="NavView"
            SelectionChanged="NavView_SelectionChanged"
            PaneDisplayMode="Auto"
            Visibility="Collapsed">

            <NavigationView.MenuItems>


                <NavigationViewItem
    Content="Inicio"
    Tag="Inicio"
    Icon="Home"/>


                <NavigationViewItem Content="Clientes"
                                    Tag="Clientes"
                                    Icon="Add" />

                <NavigationViewItem Content="Mascotas"
                                    Tag="Mascotas"
                                    Icon="Contact" />

                <NavigationViewItem Content="Citas"
                                    Tag="Citas"
                                    Icon="Calendar" />

                <NavigationViewItem Content="Búsqueda / Consultas"
                                    Tag="Busqueda"
                                    Icon="Find" />

                <NavigationViewItem Content="Modificar / Eliminar"
                                    Tag="ModificarEliminar"
                                    Icon="Edit" />

                
                <NavigationViewItem
                    Content="Historial médico"
                    Tag="HistorialMedico"
                    Icon="Document" />

                <NavigationViewItem
                    Content="Consultar historial"
                    Tag="ConsultarHistorial"
                    Icon="Find" />

               

                <NavigationViewItem
    Content="Calendario de citas"
    Tag="CalendarioCitas"
    Icon="Calendar"/>


                <NavigationViewItem
    Content="Exportar reportes PDF"
    Tag="ExportarPDF"
    Icon="Save"/>


                <NavigationViewItem Content="VetSmart AI"
                    Tag="Asistente"
                    Icon="Message" />



            </NavigationView.MenuItems>

            <Frame x:Name="MainFrame" />

        </NavigationView>

        <Frame x:Name="LoginFrame" />

    </Grid>
</Window>
