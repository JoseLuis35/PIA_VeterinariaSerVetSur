<Page
    x:Class="VeterinariaServerSurPia.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFF3E2">

    <Page.Resources>

        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

        <SolidColorBrush x:Key="TextControlForeground" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF161616"/>

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6B6B6B"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6B6B6B"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8A8A8A"/>
    </Page.Resources>

    <Grid>

        <Ellipse
            Width="520"
            Height="520"
            Fill="#FFFFA42E"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-230,-300,0,0"/>

        <Ellipse
            Width="420"
            Height="420"
            Fill="#FFFFB347"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-200,60,0,0"
            Opacity="0.55"/>

        <Ellipse
            Width="560"
            Height="560"
            Fill="#FFFF9A1F"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,-330,-200,0"/>

        <Ellipse
            Width="520"
            Height="520"
            Fill="#FFFFA42E"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,-260,-250"
            Opacity="0.85"/>

        <Ellipse
            Width="1200"
            Height="520"
            Fill="#FFFFA229"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="-260,0,0,-330"/>

        <Viewbox Stretch="Uniform" Margin="30">

            <Border
                Width="960"
                Height="650"
                Background="White"
                CornerRadius="38">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="470"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="18"
                        CornerRadius="28">

                        <Border.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,1">

                                <GradientStop
                                    Color="#FFFF9B26"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#FFF58A1F"
                                    Offset="1"/>

                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Canvas
                                x:Name="PuntosIzqSup"
                                Grid.RowSpan="3"
                                Width="170"
                                Height="110"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,25,45,0"/>

                            <Canvas
                                x:Name="PuntosIzqInf"
                                Grid.RowSpan="3"
                                Width="130"
                                Height="90"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12,0,0,230"/>

                            <StackPanel
                                Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="20,20,0,0">

                                <Border
                                    Width="58"
                                    Height="58"
                                    CornerRadius="29"
                                    Background="White"
                                    Padding="9">

                                    <Image
                                        Source="/Assets/logo_servetsur.png"
                                        Stretch="Uniform"/>

                                </Border>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="0">

                                    <TextBlock
                                        Text="VetServertSur"
                                        FontSize="26"
                                        FontWeight="Medium"
                                        Foreground="#FF1E1E1E"/>

                                    <TextBlock
                                        Text="Mascotas felices, vida feliz"
                                        FontSize="11"
                                        Foreground="#FF1E1E1E"/>

                                </StackPanel>

                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Margin="32,75,0,0"
                                Spacing="14">

                                <TextBlock
                                    Text="¡Bienvenido de nuevo!"
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Foreground="#FF161616"/>

                                <TextBlock
                                    Text="¡Te extrañamos! Inicia sesión para seguir brindando el mejor cuidado y cariño a tus mascotas."
                                    FontSize="16"
                                    Foreground="#FF1E1E1E"
                                    TextWrapping="Wrap"
                                    LineHeight="28"
                                    MaxWidth="310"
                                    HorizontalAlignment="Left"/>

                            </StackPanel>

                            <Image
                                Grid.Row="2"
                                Source="/Assets/mujer_perro.png"
                                Stretch="Uniform"
                                VerticalAlignment="Bottom"
                                Margin="25,0,25,12"/>

                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">

                        <Canvas
                            x:Name="PuntosDerSup"
                            Width="190"
                            Height="130"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,30,30,0"/>

                        <Canvas
                            x:Name="PuntosDerInf"
                            Width="200"
                            Height="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,25,20"/>

                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="40,0,0,0"
                            Width="384"
                            Spacing="18">

                            <StackPanel
                                Spacing="14"
                                Margin="0,0,0,18">

                                <TextBlock
                                    Text="Iniciar sesión"
                                    FontSize="36"
                                    FontWeight="Bold"
                                    Foreground="#FF161616"/>

                                <TextBlock
                                    Text="Por favor inicia sesión con tus credenciales."
                                    FontSize="14"
                                    Foreground="#FF1E1E1E"/>

                            </StackPanel>

                            <Border
                                Height="52"
                                CornerRadius="10"
                                BorderBrush="#FF4A4A4A"
                                BorderThickness="1.2"
                                Background="White"
                                Padding="14,0,10,0">

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Glyph="&#xE77B;"
                                        FontSize="18"
                                        Foreground="#FF2A2A2A"
                                        VerticalAlignment="Center"/>

                                    <TextBox
                                        x:Name="TxtUsuario"
                                        Grid.Column="1"
                                        PlaceholderText="Usuario"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="#FF161616"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        AutomationProperties.Name="Usuario"
                                        BeforeTextChanging="TxtUsuario_BeforeTextChanging"
                                        KeyDown="TxtUsuario_KeyDown"/>

                                </Grid>
                            </Border>

                            <Border
                                Height="52"
                                CornerRadius="10"
                                BorderBrush="#FF4A4A4A"
                                BorderThickness="1.2"
                                Background="White"
                                Padding="14,0,10,0">

                                <Grid ColumnSpacing="16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Glyph="&#xE72E;"
                                        FontSize="18"
                                        Foreground="#FF2A2A2A"
                                        VerticalAlignment="Center"/>

                                    <PasswordBox
                                        x:Name="TxtPassword"
                                        Grid.Column="1"
                                        PlaceholderText="Contraseña"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="#FF161616"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        AutomationProperties.Name="Contraseña"
                                        PasswordChanged="TxtPassword_PasswordChanged"
                                        KeyDown="TxtPassword_KeyDown"/>

                                </Grid>
                            </Border>

                            <Border
                                x:Name="PanelError"
                                Background="#FFFFF0ED"
                                CornerRadius="8"
                                Padding="10"
                                Visibility="Collapsed">

                                <TextBlock
                                    x:Name="TxtError"
                                    Foreground="#FFC0392B"
                                    FontSize="12"
                                    TextWrapping="Wrap"/>

                            </Border>

                            <Button
                                x:Name="BtnLogin"
                                Height="52"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="26"
                                BorderThickness="0"
                                Background="#FFFF9A1F"
                                Foreground="#FF161616"
                                Click="BtnLogin_Click">

                                <Button.Resources>

                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#FFF58A1F"/>

                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#FFE67E14"/>

                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPointerOver"
                                        Color="#FF161616"/>

                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPressed"
                                        Color="#FF161616"/>

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="Transparent"/>

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="Transparent"/>

                                </Button.Resources>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="22">

                                    <TextBlock
                                        Text="Iniciar sesión"
                                        FontSize="16"
                                        FontWeight="SemiBold"/>

                                    <FontIcon
                                        Glyph="&#xE72A;"
                                        FontSize="16"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Page>
