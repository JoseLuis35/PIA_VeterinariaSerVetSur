<Page
    x:Class="VeterinariaServerSurPia.Views.BusquedaConsulta"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VeterinariaServerSurPia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FF13171A"
    mc:Ignorable="d">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                Text="Búsqueda y Consulta"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#FFF1F3F5"/>

            <TextBlock
                Text="Veterinaria Servetsur Mty — Gestión de registros"
                FontSize="14"
                Foreground="#FF909EA6"
                Margin="0,4,0,0"/>
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="#FF1D2328"
            BorderBrush="#FF2A333B"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20"
            Margin="0,0,0,12">

            <ScrollViewer
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">

                    <ComboBox
                        x:Name="CategoriaCombo"
                        Header="Categoría"
                        Width="150"
                        SelectionChanged="CategoriaCombo_SelectionChanged">
                        <x:String>Clientes</x:String>
                        <x:String>Mascotas</x:String>
                        <x:String>Citas</x:String>
                    </ComboBox>

                    <ComboBox
                        x:Name="CriterioCombo"
                        Header="Buscar por"
                        Width="170"/>

                    <TextBox
                        x:Name="BusquedaText"
                        Header="Término de búsqueda"
                        Width="200"
                        MaxLength="100"
                        VerticalAlignment="Bottom"/>

                    <ComboBox
                        x:Name="FiltroServicioCombo"
                        Header="Filtrar servicio"
                        Width="170"
                        Visibility="Collapsed">
                        <x:String>Todos</x:String>
                        <x:String>Consulta médica</x:String>
                        <x:String>Baño y corte</x:String>
                        <x:String>Vacunación</x:String>
                        <x:String>Desparasitación</x:String>
                    </ComboBox>

                    <Button
                        Content="Buscar"
                        Click="BuscarBtn_Click"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"/>

                    <Button
                        Content="Actualizar"
                        Click="ActualizarBtn_Click"
                        VerticalAlignment="Bottom"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock
            x:Name="TxtEstadoBusqueda"
            Grid.Row="2"
            TextWrapping="Wrap"
            Margin="4,0,0,12"
            Foreground="#FF90C590"/>

        <!-- Clientes -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">

            <ListView
                x:Name="ClientesListView"
                MinWidth="700"
                Visibility="Collapsed"
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="10">

                <ListView.Header>
                    <Grid Padding="16,14" Background="#FF263138">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ID Cliente" Foreground="#FFE1E6EB" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Nombre" Foreground="#FFE1E6EB" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Teléfono" Foreground="#FFE1E6EB" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Correo" Foreground="#FFE1E6EB" FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Cliente">
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind IDCliente}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Nombre}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Telefono}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Correo}" Foreground="#FFD0D7DE"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Mascotas -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">

            <ListView
                x:Name="MascotasListView"
                MinWidth="1100"
                Visibility="Collapsed"
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="10">

                <ListView.Header>
                    <Grid Padding="16,14" Background="#FF263138">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ID Mascota" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="1" Text="Nombre" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="2" Text="Especie" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="3" Text="Raza" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="4" Text="Edad" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="5" Text="Sexo" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="6" Text="Peso" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="7" Text="ID Cliente" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="8" Text="Propietario" Foreground="#FFE1E6EB"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Mascota">
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind IDMascota}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Nombre}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Especie}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Raza}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Edad}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Sexo}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind Peso}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind IDCliente}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="8" Text="{x:Bind NombrePropietario}" Foreground="#FFD0D7DE"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Citas -->
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">

            <ListView
                x:Name="CitasListView"
                MinWidth="1250"
                Visibility="Collapsed"
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="10">

                <ListView.Header>
                    <Grid Padding="16,14" Background="#FF263138">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ID Cita" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="1" Text="ID Mascota" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="2" Text="Mascota" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="3" Text="Dueño" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="4" Text="Fecha" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="5" Text="Hora" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="6" Text="Servicio" Foreground="#FFE1E6EB"/>
                        <TextBlock Grid.Column="7" Text="Observaciones" Foreground="#FFE1E6EB"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Cita">
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind IDCita}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind IDMascota}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind NombreMascota}" Foreground="#FFD0D7DE" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind NombrePropietario}" Foreground="#FFD0D7DE" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Fecha}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind Hora}" Foreground="#FFD0D7DE"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind Servicio}" Foreground="#FFD0D7DE" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind Observaciones}" Foreground="#FFD0D7DE" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
