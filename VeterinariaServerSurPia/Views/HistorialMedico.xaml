<Page
    x:Class="VeterinariaServerSurPia.Views.HistorialMedico"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF13171A">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18">

            <StackPanel Spacing="5">
                <TextBlock
                    Text="Expediente médico"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#FFF1F3F5"/>

                <TextBlock
                    Text="Historial clínico y cartilla de salud de cada mascota"
                    Foreground="#FF909EA6"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Selección de mascota -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="1. Seleccionar mascota"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock
                        Text="Mascota registrada"
                        Foreground="#FFD0D7DE"/>

                    <ComboBox
                        x:Name="MascotaCombo"
                        PlaceholderText="Selecciona una mascota"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="TextoMostrar"
                        SelectionChanged="MascotaCombo_SelectionChanged"/>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="ID de mascota" Foreground="#FF909EA6"/>
                            <TextBlock
                                x:Name="TxtIdMascota"
                                Text="—"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FFF1F3F5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Nombre" Foreground="#FF909EA6"/>
                            <TextBlock
                                x:Name="TxtNombreMascota"
                                Text="—"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FFF1F3F5"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Especie y raza" Foreground="#FF909EA6"/>
                            <TextBlock
                                x:Name="TxtEspecieRaza"
                                Text="—"
                                Foreground="#FFD0D7DE"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Propietario" Foreground="#FF909EA6"/>
                            <TextBlock
                                x:Name="TxtPropietario"
                                Text="—"
                                Foreground="#FFD0D7DE"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Registrar consulta -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="2. Registrar consulta médica"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock Text="Fecha de consulta" Foreground="#FFD0D7DE"/>

                    <DatePicker
                        x:Name="FechaConsultaPicker"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Peso actual (kg)" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtPeso"
                        PlaceholderText="Ej. 12.5"
                        InputScope="Number"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Motivo de consulta" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtMotivo"
                        PlaceholderText="¿Por qué acude la mascota?"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Síntomas" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtSintomas"
                        PlaceholderText="Síntomas observados o reportados"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Diagnóstico" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtDiagnostico"
                        PlaceholderText="Diagnóstico indicado por el veterinario"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Tratamiento" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtTratamiento"
                        PlaceholderText="Tratamiento o indicaciones"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Alergias conocidas" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtAlergias"
                        PlaceholderText="Alergias conocidas o Ninguna conocida"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Antecedentes médicos" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtAntecedentes"
                        PlaceholderText="Enfermedades previas, cirugías y otros antecedentes"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <TextBlock Text="Observaciones adicionales" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtObservaciones"
                        PlaceholderText="Notas adicionales"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="65"/>

                    <Button
                        Content="Guardar consulta médica"
                        Click="BtnGuardarConsulta_Click"
                        Height="44"
                        HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Registrar cartilla -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="3. Cartilla médica"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock
                        Text="Tipo de registro"
                        Foreground="#FFD0D7DE"/>

                    <ComboBox
                        x:Name="TipoCartillaCombo"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Vacuna"/>
                        <ComboBoxItem Content="Desparasitación"/>
                    </ComboBox>

                    <TextBlock
                        Text="Nombre de vacuna o producto"
                        Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtProducto"
                        PlaceholderText="Ej. vacuna antirrábica o producto utilizado"/>

                    <TextBlock Text="Fecha de aplicación" Foreground="#FFD0D7DE"/>

                    <DatePicker
                        x:Name="FechaAplicacionPicker"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock
                        Text="Próxima fecha programada"
                        Foreground="#FFD0D7DE"/>

                    <DatePicker
                        x:Name="FechaProximaPicker"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Observaciones" Foreground="#FFD0D7DE"/>

                    <TextBox
                        x:Name="TxtObservacionesCartilla"
                        PlaceholderText="Notas adicionales"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="60"/>

                    <Button
                        Content="Guardar registro de cartilla"
                        Click="BtnGuardarCartilla_Click"
                        Height="44"
                        HorizontalAlignment="Stretch"/>

                    <Button
                        x:Name="BtnConsultarHistorial"
                        Content="Consultar historial médico"
                        Click="BtnConsultarHistorial_Click"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Background="#FFF28C00"
                        Foreground="#FF171717"
                        FontWeight="SemiBold"
                        Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="TxtMensaje"
                TextWrapping="Wrap"
                FontWeight="SemiBold"
                Foreground="#FF9ED9B5"
                Margin="0,0,0,12"/>


            <ListView
    x:Name="HistorialListView"
    Visibility="Collapsed" />

            <ListView
    x:Name="CartillaListView"
    Visibility="Collapsed" />


        </StackPanel>
    </ScrollViewer>
</Page>
