<Page
    x:Class="VeterinariaServerSurPia.Views.HistorialMedico"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFF6EA">

    <Page.Resources>

        <!-- TARJETAS -->
        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFF6E6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="24,22"/>
        </Style>

        <!-- TÍTULOS -->
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF76695D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF65584C"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
        </Style>

        <!-- CAMPOS -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="BorderBrush" Value="#FFF3D9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CampoSeleccion" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="BorderBrush" Value="#FFF3D9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CampoFecha" TargetType="DatePicker">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="BorderBrush" Value="#FFF3D9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- BOTONES -->
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#FFFF9A1F"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#FFFFF1DD"/>
            <Setter Property="Foreground" Value="#FF80501D"/>
            <Setter Property="BorderBrush" Value="#FFF3D9B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Border Padding="30,24">

            <StackPanel
                MaxWidth="900"
                HorizontalAlignment="Center"
                Spacing="20">

                <!-- ENCABEZADO -->

                <Border
                    CornerRadius="26"
                    Padding="26,22"
                    BorderThickness="1"
                    BorderBrush="#FFFFD39B">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFF0DB" Offset="0"/>
                            <GradientStop Color="#FFFFD9A6" Offset="0.65"/>
                            <GradientStop Color="#FFFFB866" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="82"
                            Height="82"
                            CornerRadius="41"
                            Background="#FFFFFFFF"
                            VerticalAlignment="Center">

                            <Image
                                Source="/Assets/logo_servetsur.png"
                                Width="68"
                                Height="68"
                                Stretch="Uniform"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="6"
                            Margin="18,0,0,0">

                            <TextBlock
                                Text="ÁREA MÉDICA"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#FF9B5A13"
                                CharacterSpacing="120"/>

                            <TextBlock
                                Text="Expediente médico"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#FF1F140A"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Administra consultas clínicas, antecedentes y cartilla de salud de cada mascota."
                                FontSize="13"
                                Foreground="#FF654A2E"
                                TextWrapping="Wrap"/>

                            <Border
                                Background="#CCFFFFFF"
                                CornerRadius="15"
                                Padding="12,5"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0">

                                <TextBlock
                                    Text="SERVETSUR MTY  ·  SALUD ANIMAL"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF80501D"/>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. SELECCIÓN DE MASCOTA -->

                <Border Style="{StaticResource TarjetaSeccion}">

                    <StackPanel Spacing="16">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Border
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#FFFF9A1F">

                                <FontIcon
                                    Glyph="&#xE8D4;"
                                    FontSize="19"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="1. Seleccionar mascota"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Identifica al paciente para consultar su expediente."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Text="Mascota registrada"
                            Style="{StaticResource EtiquetaCampo}"/>

                        <ComboBox
                            x:Name="MascotaCombo"
                            Style="{StaticResource CampoSeleccion}"
                            PlaceholderText="Selecciona una mascota"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="TextoMostrar"
                            SelectionChanged="MascotaCombo_SelectionChanged"/>

                        <Border
                            Background="#FFFFF8EF"
                            BorderBrush="#FFF4E4CF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="17">

                            <StackPanel Spacing="14">

                                <TextBlock
                                    Text="Información del paciente"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#FF80501D"/>

                                <Grid RowSpacing="13">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock
                                            Text="ID de mascota"
                                            Style="{StaticResource EtiquetaCampo}"/>

                                        <TextBlock
                                            x:Name="TxtIdMascota"
                                            Text="—"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#FF1F140A"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Text="Nombre"
                                            Style="{StaticResource EtiquetaCampo}"/>

                                        <TextBlock
                                            x:Name="TxtNombreMascota"
                                            Text="—"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#FF1F140A"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock
                                            Text="Especie y raza"
                                            Style="{StaticResource EtiquetaCampo}"/>

                                        <TextBlock
                                            x:Name="TxtEspecieRaza"
                                            Text="—"
                                            FontSize="14"
                                            Foreground="#FF5A4E42"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Text="Propietario"
                                            Style="{StaticResource EtiquetaCampo}"/>

                                        <TextBlock
                                            x:Name="TxtPropietario"
                                            Text="—"
                                            FontSize="14"
                                            Foreground="#FF5A4E42"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#FFFFF1DD"
                            CornerRadius="13"
                            Padding="13,10">

                            <TextBlock
                                Text="Selecciona una mascota para cargar automáticamente sus datos y consultar sus registros médicos."
                                FontSize="12"
                                Foreground="#FF765333"
                                TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- 2. CONSULTA MÉDICA -->

                <Border Style="{StaticResource TarjetaSeccion}">

                    <StackPanel Spacing="16">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Border
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#FFFF9A1F">

                                <FontIcon
                                    Glyph="&#xE8EC;"
                                    FontSize="19"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="2. Registrar consulta médica"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Documenta la valoración y atención veterinaria."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Background="#FFFFF8EF"
                            CornerRadius="15"
                            Padding="16">

                            <StackPanel Spacing="13">

                                <TextBlock
                                    Text="Datos de la consulta"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#FF80501D"/>

                                <TextBlock
                                    Text="Fecha de consulta"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <DatePicker
                                    x:Name="FechaConsultaPicker"
                                    Style="{StaticResource CampoFecha}"
                                    HorizontalAlignment="Stretch"/>

                                <TextBlock
                                    Text="Peso actual (kg)"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <TextBox
                                    x:Name="TxtPeso"
                                    Style="{StaticResource CampoTexto}"
                                    PlaceholderText="Ej. 12.5"
                                    InputScope="Number"
                                    HorizontalAlignment="Stretch"/>

                            </StackPanel>
                        </Border>

                        <TextBlock
                            Text="Evaluación clínica"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FF80501D"/>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Motivo de consulta"
                                Style="{StaticResource EtiquetaCampo}"/>

                            <TextBox
                                x:Name="TxtMotivo"
                                Style="{StaticResource CampoTexto}"
                                PlaceholderText="¿Por qué acude la mascota?"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="76"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Síntomas"
                                Style="{StaticResource EtiquetaCampo}"/>

                            <TextBox
                                x:Name="TxtSintomas"
                                Style="{StaticResource CampoTexto}"
                                PlaceholderText="Síntomas observados o reportados"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="76"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Diagnóstico"
                                Style="{StaticResource EtiquetaCampo}"/>

                            <TextBox
                                x:Name="TxtDiagnostico"
                                Style="{StaticResource CampoTexto}"
                                PlaceholderText="Diagnóstico indicado por el veterinario"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="76"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Tratamiento"
                                Style="{StaticResource EtiquetaCampo}"/>

                            <TextBox
                                x:Name="TxtTratamiento"
                                Style="{StaticResource CampoTexto}"
                                PlaceholderText="Tratamiento o indicaciones"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="76"/>
                        </StackPanel>

                        <Border
                            Background="#FFFFF8EF"
                            CornerRadius="15"
                            Padding="16">

                            <StackPanel Spacing="13">

                                <TextBlock
                                    Text="Antecedentes y cuidados especiales"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#FF80501D"/>

                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Text="Alergias conocidas"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtAlergias"
                                        Style="{StaticResource CampoTexto}"
                                        PlaceholderText="Alergias conocidas o Ninguna conocida"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="68"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Text="Antecedentes médicos"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtAntecedentes"
                                        Style="{StaticResource CampoTexto}"
                                        PlaceholderText="Enfermedades previas, cirugías y otros antecedentes"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="68"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock
                                        Text="Observaciones adicionales"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtObservaciones"
                                        Style="{StaticResource CampoTexto}"
                                        PlaceholderText="Notas adicionales"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="68"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <Button
                            Style="{StaticResource BotonPrincipal}"
                            Click="BtnGuardarConsulta_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">

                                <FontIcon Glyph="&#xE74E;" FontSize="17"/>
                                <TextBlock Text="Guardar consulta médica"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- 3. CARTILLA MÉDICA -->

                <Border Style="{StaticResource TarjetaSeccion}">

                    <StackPanel Spacing="16">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Border
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#FFFF9A1F">

                                <FontIcon
                                    Glyph="&#xE8D7;"
                                    FontSize="19"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="3. Cartilla médica"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Registra vacunas y desparasitaciones."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Background="#FFFFF8EF"
                            CornerRadius="15"
                            Padding="16">

                            <StackPanel Spacing="13">

                                <TextBlock
                                    Text="Información de aplicación"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#FF80501D"/>

                                <TextBlock
                                    Text="Tipo de registro"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <ComboBox
                                    x:Name="TipoCartillaCombo"
                                    Style="{StaticResource CampoSeleccion}"
                                    SelectedIndex="0"
                                    HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Vacuna"/>
                                    <ComboBoxItem Content="Desparasitación"/>

                                </ComboBox>

                                <TextBlock
                                    Text="Nombre de vacuna o producto"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <TextBox
                                    x:Name="TxtProducto"
                                    Style="{StaticResource CampoTexto}"
                                    PlaceholderText="Ej. vacuna antirrábica o producto utilizado"/>

                                <TextBlock
                                    Text="Fecha de aplicación"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <DatePicker
                                    x:Name="FechaAplicacionPicker"
                                    Style="{StaticResource CampoFecha}"
                                    HorizontalAlignment="Stretch"/>

                                <TextBlock
                                    Text="Próxima fecha programada"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <DatePicker
                                    x:Name="FechaProximaPicker"
                                    Style="{StaticResource CampoFecha}"
                                    HorizontalAlignment="Stretch"/>

                                <TextBlock
                                    Text="Observaciones"
                                    Style="{StaticResource EtiquetaCampo}"/>

                                <TextBox
                                    x:Name="TxtObservacionesCartilla"
                                    Style="{StaticResource CampoTexto}"
                                    PlaceholderText="Notas adicionales"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="75"/>

                            </StackPanel>
                        </Border>

                        <Button
                            Style="{StaticResource BotonPrincipal}"
                            Click="BtnGuardarCartilla_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">

                                <FontIcon Glyph="&#xE74E;" FontSize="17"/>
                                <TextBlock Text="Guardar registro de cartilla"/>

                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="BtnConsultarHistorial"
                            Style="{StaticResource BotonSecundario}"
                            Click="BtnConsultarHistorial_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">

                                <FontIcon Glyph="&#xE8A5;" FontSize="17"/>
                                <TextBlock Text="Consultar historial médico"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ESTADO DE OPERACIÓN -->

                <Border
                    Background="#FFFFF1DD"
                    BorderBrush="#FFF4DDBD"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,15">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#FFFFDDAA">

                            <FontIcon
                                Glyph="&#xE946;"
                                Foreground="#FF9A5A13"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Estado de operación"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#FF9A5A13"/>

                            <TextBlock
                                x:Name="TxtMensaje"
                                Text="Selecciona una mascota para comenzar."
                                TextWrapping="Wrap"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FF493626"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LISTAS UTILIZADAS POR EL CODE-BEHIND -->

                <ListView
                    x:Name="HistorialListView"
                    Visibility="Collapsed"/>

                <ListView
                    x:Name="CartillaListView"
                    Visibility="Collapsed"/>

                <!-- PIE DE PÁGINA -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,5,0,12">

                    <Image
                        Source="/Assets/huella.png"
                        Width="32"
                        Height="32"
                        Opacity="0.55"/>

                    <TextBlock
                        Text="SERVETSUR · CUIDAMOS LO QUE MÁS QUIERES"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#FFB18B60"
                        CharacterSpacing="70"
                        TextAlignment="Center"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
