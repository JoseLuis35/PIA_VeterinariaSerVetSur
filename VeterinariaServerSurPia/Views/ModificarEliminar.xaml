<Page
    x:Class="VeterinariaServerSurPia.Views.ModificarEliminar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20">

            <StackPanel Spacing="5">
                <TextBlock
                    Text="Administración integral"
                    FontSize="30"
                    FontWeight="Bold"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Text="Selecciona un cliente para administrar sus datos, mascotas y citas relacionadas."
                    Opacity="0.75"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <Border
                Padding="20"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="1. Seleccionar cliente"
                        FontSize="21"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Buscar por nombre o ID"
                        Opacity="0.75"/>

                    <TextBox
                        x:Name="TxtBuscarCliente"
                        PlaceholderText="Escribe el nombre o ID del cliente"
                        TextChanged="TxtBuscarCliente_TextChanged"/>

                    <ComboBox
                        x:Name="ClienteCombo"
                        PlaceholderText="Selecciona un cliente"
                        DisplayMemberPath="TextoMostrar"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ClienteCombo_SelectionChanged"/>

                    <TextBlock
                        x:Name="TxtEstadoCliente"
                        Text="Selecciona un cliente para comenzar."
                        TextWrapping="Wrap"
                        Opacity="0.8"/>

                </StackPanel>
            </Border>

            <Border
                Padding="20"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="2. Información del cliente"
                        FontSize="21"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="ID del cliente"
                        Opacity="0.75"/>

                    <TextBox
                        x:Name="TxtIDCliente"
                        IsReadOnly="True"/>

                    <TextBlock Text="Nombre completo"/>

                    <TextBox
                        x:Name="TxtNombreCliente"
                        PlaceholderText="Nombre del cliente"/>

                    <TextBlock Text="Teléfono"/>

                    <TextBox
                        x:Name="TxtTelefonoCliente"
                        PlaceholderText="10 dígitos"
                        MaxLength="10"/>

                    <TextBlock Text="Correo electrónico"/>

                    <TextBox
                        x:Name="TxtCorreoCliente"
                        PlaceholderText="ejemplo@correo.com"/>

                    <TextBlock
                        x:Name="TxtEstadoBaja"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Guardar cliente"
                            Click="BtnGuardarCliente_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>

                        <Button
                            Grid.Column="1"
                            x:Name="BtnDarBajaCliente"
                            Content="Dar de baja cliente"
                            Click="BtnDarBajaCliente_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>
                    </Grid>

                    <Button
                        x:Name="BtnEliminarCliente"
                        Content="Eliminar cliente"
                        Click="BtnEliminarCliente_Click"
                        HorizontalAlignment="Stretch"
                        Height="44"/>

                    <TextBlock
                        Text="Nota: si el cliente tiene mascotas registradas, no podrá eliminarse definitivamente. Puedes darlo de baja para conservar su información."
                        Opacity="0.7"
                        TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <Border
                Padding="20"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="3. Mascotas del cliente"
                        FontSize="21"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Selecciona una mascota para consultar o modificar su información."
                        Opacity="0.75"
                        TextWrapping="Wrap"/>

                    <ListView
                        x:Name="MascotasListView"
                        SelectionMode="Single"
                        MaxHeight="220"
                        SelectionChanged="MascotasListView_SelectionChanged">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="3">

                                    <TextBlock
                                        Text="{Binding Titulo}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Detalle}"
                                        Opacity="0.75"
                                        TextWrapping="Wrap"/>

                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Text="ID de mascota"
                        Opacity="0.75"/>

                    <TextBox
                        x:Name="TxtIDMascota"
                        IsReadOnly="True"/>

                    <TextBlock Text="Nombre de la mascota"/>

                    <TextBox
                        x:Name="TxtNombreMascota"
                        PlaceholderText="Nombre de la mascota"/>

                    <Grid
                        ColumnSpacing="10"
                        RowSpacing="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="5">

                            <TextBlock Text="Especie"/>

                            <TextBox
                                x:Name="TxtEspecieMascota"
                                PlaceholderText="Ej. Perro"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="5">

                            <TextBlock Text="Raza"/>

                            <TextBox
                                x:Name="TxtRazaMascota"
                                PlaceholderText="Ej. Labrador"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="5">

                            <TextBlock Text="Edad"/>

                            <TextBox
                                x:Name="TxtEdadMascota"
                                PlaceholderText="Edad en años"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="5">

                            <TextBlock Text="Sexo"/>

                            <TextBox
                                x:Name="TxtSexoMascota"
                                PlaceholderText="Macho o hembra"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Peso (kg)"/>

                    <TextBox
                        x:Name="TxtPesoMascota"
                        PlaceholderText="Ej. 12.5"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Guardar mascota"
                            Click="BtnGuardarMascota_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>

                        <Button
                            Grid.Column="1"
                            Content="Eliminar mascota"
                            Click="BtnEliminarMascota_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>
                    </Grid>

                    <Button
                        Content="Abrir expediente médico"
                        Click="BtnVerExpediente_Click"
                        HorizontalAlignment="Stretch"
                        Height="44"/>

                    <TextBlock
                        Text="No se podrá eliminar una mascota que tenga citas registradas."
                        Opacity="0.7"
                        TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
            
            <Border
                Padding="20"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="12">

                    <TextBlock
                        Text="4. Citas de sus mascotas"
                        FontSize="21"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Selecciona una cita para modificarla o eliminarla."
                        Opacity="0.75"
                        TextWrapping="Wrap"/>

                    <ListView
                        x:Name="CitasListView"
                        SelectionMode="Single"
                        MaxHeight="250"
                        SelectionChanged="CitasListView_SelectionChanged">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="3">

                                    <TextBlock
                                        Text="{Binding Titulo}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Detalle}"
                                        Opacity="0.75"
                                        TextWrapping="Wrap"/>

                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Text="ID de cita"
                        Opacity="0.75"/>

                    <TextBox
                        x:Name="TxtIDCita"
                        IsReadOnly="True"/>

                    <TextBlock
                        Text="ID de la mascota"
                        Opacity="0.75"/>

                    <TextBox
                        x:Name="TxtMascotaCita"
                        IsReadOnly="True"/>

                    <TextBlock Text="Fecha de la cita"/>

                    <DatePicker
                        x:Name="FechaCitaPicker"
                        HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Hora (formato 24 horas)"/>

                    <TextBox
                        x:Name="TxtHoraCita"
                        PlaceholderText="Ej. 14:30"
                        MaxLength="8"/>

                    <TextBlock Text="Servicio"/>

                    <TextBox
                        x:Name="TxtServicioCita"
                        PlaceholderText="Servicio veterinario"/>

                    <TextBlock Text="Observaciones"/>

                    <TextBox
                        x:Name="TxtObservacionesCita"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxLength="500"
                        MinHeight="90"
                        PlaceholderText="Observaciones de la cita"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Guardar cita"
                            Click="BtnGuardarCita_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>

                        <Button
                            Grid.Column="1"
                            Content="Eliminar cita"
                            Click="BtnEliminarCita_Click"
                            HorizontalAlignment="Stretch"
                            Height="44"/>
                    </Grid>

                    <TextBlock
                        Text="Al modificar una cita, la nueva fecha y hora deben ser futuras y no estar ocupadas por otra cita."
                        Opacity="0.7"
                        TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- MENSAJES -->
            <Border
                Padding="16"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Estado de la operación"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtMensaje"
                        Text="Selecciona un cliente para comenzar."
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button
                Content="Volver a Búsqueda / Consultas"
                Click="BtnIrBusqueda_Click"
                HorizontalAlignment="Stretch"
                Height="44"/>

        </StackPanel>
    </ScrollViewer>
</Page>
