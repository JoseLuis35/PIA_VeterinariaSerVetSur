<Page
    x:Class="VeterinariaServerSurPia.Views.RegistrarCliente"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VeterinariaServerSurPia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#FFFFF6EA"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>

        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFF6E6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="30,26"/>
        </Style>

        <Style x:Key="CajaInfo" TargetType="Border">
            <Setter Property="Background" Value="#FFFFF1DD"/>
            <Setter Property="BorderBrush" Value="#FFF8E2C2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFE3D6C3"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFD9B98C"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFF28C28"/>
        <SolidColorBrush x:Key="TextControlForeground" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF161616"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E857B"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E857B"/>
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FFA89E92"/>
        <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#FF5A4E42"/>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFE3D6C3"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFD9B98C"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFF28C28"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#FFF28C28"/>
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF161616"/>
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FF161616"/>
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF8E857B"/>

        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFF9A1F"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF58A1F"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE67E14"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFD9A8"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#FF161616"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF161616"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF161616"/>
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF8A6A3A"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>

    </Page.Resources>

    <ScrollViewer
        Padding="28,24,28,24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Auto"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <StackPanel
            Spacing="22"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Border
                CornerRadius="26"
                Padding="30,24"
                HorizontalAlignment="Stretch">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFF0DB" Offset="0"/>
                        <GradientStop Color="#FFFFD9A6" Offset="0.6"/>
                        <GradientStop Color="#FFFFB866" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.ColumnSpan="3"
                        Source="/Assets/huella.png"
                        Width="62"
                        Height="62"
                        Opacity="0.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,170,0"
                        RenderTransformOrigin="0.5,0.5"
                        IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <RotateTransform Angle="-15"/>
                        </Image.RenderTransform>
                    </Image>

                    <Image
                        Grid.ColumnSpan="3"
                        Source="/Assets/huella.png"
                        Width="38"
                        Height="38"
                        Opacity="0.4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,250,-6"
                        RenderTransformOrigin="0.5,0.5"
                        IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <RotateTransform Angle="20"/>
                        </Image.RenderTransform>
                    </Image>

                    <Border
                        Width="82"
                        Height="82"
                        CornerRadius="41"
                        Background="White"
                        BorderBrush="#FFFFE6CC"
                        BorderThickness="3"
                        Padding="12"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/logo_servetsur.png"
                            Stretch="Uniform"/>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <TextBlock
                            Text="Registro de Clientes"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="#FF1F140A"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="Ingresa la información del propietario o cliente para darlo de alta en el sistema."
                            FontSize="14"
                            Foreground="#FF2B1A0A"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="VETERINARIA SERVETSUR MTY"
                            FontSize="10"
                            FontWeight="Bold"
                            CharacterSpacing="150"
                            Foreground="#FFB4621C"
                            Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Background="White"
                        BorderBrush="#FFF3D9B8"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="16,10"
                        VerticalAlignment="Center">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="9">

                            <FontIcon
                                Glyph="&#xE8FA;"
                                FontSize="15"
                                Foreground="#FFE0710F"/>

                            <TextBlock
                                Text="Nuevo cliente"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FF1F140A"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Style="{StaticResource TarjetaSeccion}"
                HorizontalAlignment="Stretch">

                <Grid>

                    <Image
                        Source="/Assets/huella.png"
                        Width="100"
                        Height="100"
                        Stretch="Uniform"
                        Opacity="0.35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,4,0"
                        IsHitTestVisible="False"/>

                    <StackPanel
                        Spacing="22"
                        HorizontalAlignment="Stretch">

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="46"
                                Height="46"
                                CornerRadius="23"
                                Background="#FFFF9A1F"
                                VerticalAlignment="Top">

                                <FontIcon
                                    Glyph="&#xE77B;"
                                    FontSize="19"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="4"
                                Margin="0,0,110,0">

                                <TextBlock
                                    Text="Datos Generales del Cliente"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#FF1F140A"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="Completa los datos del propietario. Debes ingresar al menos un teléfono o un correo."
                                    FontSize="13"
                                    LineHeight="20"
                                    Foreground="#FF6B5E50"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CajaInfo}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Glyph="&#xE8EC;"
                                    FontSize="21"
                                    Foreground="#FFE0710F"
                                    VerticalAlignment="Center"/>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="ID del Cliente"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#FF2B2118"/>

                                    <TextBlock
                                        Text="Se asigna automáticamente"
                                        FontSize="12"
                                        Foreground="#FF7A6A58"/>
                                </StackPanel>

                                <TextBlock
                                    x:Name="TxtIdCliente"
                                    Grid.Column="2"
                                    Text="C0001"
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Foreground="#FFE0710F"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBox
                            x:Name="TxtNombreCliente"
                            Header="Nombre Completo"
                            PlaceholderText="Ej. Juan Pérez"
                            MaxLength="80"
                            MinHeight="48"
                            CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            TextChanging="TxtNombreCliente_TextChanging"/>

                        <Grid
                            ColumnSpacing="18"
                            RowSpacing="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="TxtTelefono"
                                Grid.Column="0"
                                Header="Teléfono"
                                PlaceholderText="Ej. 8123456789"
                                MaxLength="10"
                                MinHeight="48"
                                CornerRadius="12"
                                InputScope="TelephoneNumber"
                                HorizontalAlignment="Stretch"
                                TextChanging="TxtTelefono_TextChanging"/>

                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="TxtCorreo"
                                    Grid.Column="0"
                                    Header="Correo Electrónico"
                                    PlaceholderText="Ej. juan@gmail.com"
                                    MaxLength="100"
                                    MinHeight="48"
                                    CornerRadius="12"
                                    InputScope="EmailSmtpAddress"
                                    HorizontalAlignment="Stretch"
                                    TextChanging="TxtCorreo_TextChanging"/>

                                <ComboBox
                                    x:Name="CmbProveedorCorreo"
                                    Grid.Column="1"
                                    Header="Proveedor"
                                    PlaceholderText="Seleccionar"
                                    SelectedIndex="0"
                                    MinHeight="48"
                                    CornerRadius="12"
                                    SelectionChanged="CmbProveedorCorreo_SelectionChanged"
                                    HorizontalAlignment="Stretch">

                                    <ComboBoxItem Content="Automático"/>
                                    <ComboBoxItem Content="Gmail"/>
                                    <ComboBoxItem Content="Outlook"/>
                                    <ComboBoxItem Content="iCloud"/>

                                </ComboBox>
                            </Grid>
                        </Grid>

                        <TextBlock
                            Text="Puedes escribir el correo completo o seleccionar un proveedor para completar el dominio. El teléfono y el correo deben ser únicos."
                            FontSize="12"
                            Foreground="#FF7A6A58"
                            TextWrapping="Wrap"/>

                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel
                Spacing="16"
                HorizontalAlignment="Stretch">

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BtnGuardarCliente"
                        Grid.Column="0"
                        Click="BtnGuardarCliente_Click"
                        HorizontalAlignment="Stretch"
                        Height="54"
                        CornerRadius="27"
                        FontSize="15"
                        FontWeight="SemiBold">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Center">

                            <FontIcon Glyph="&#xE74E;" FontSize="17"/>
                            <TextBlock Text="Guardar Cliente"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Click="BtnIrMascotas_Click"
                        HorizontalAlignment="Stretch"
                        Height="54"
                        CornerRadius="27"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="1.2">

                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFF1DD"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFE3BF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFF28C28"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFF28C28"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFE67E14"/>
                        </Button.Resources>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Center">

                            <TextBlock Text="Ir a Registrar Mascota"/>
                            <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    x:Name="PanelMensaje"
                    Visibility="Collapsed"
                    CornerRadius="14"
                    BorderThickness="1"
                    Padding="20,16"
                    HorizontalAlignment="Stretch">

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            x:Name="IconoMensaje"
                            FontSize="21"
                            VerticalAlignment="Top"/>

                        <TextBlock
                            x:Name="TxtMensaje"
                            Grid.Column="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            LineHeight="22"
                            TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="46"
                HorizontalAlignment="Center"
                Margin="0,0,0,24">

                <Image
                    Source="/Assets/huella.png"
                    Width="36"
                    Height="36"
                    Opacity="0.35"
                    Margin="0,32,0,0"
                    RenderTransformOrigin="0.5,0.5"
                    IsHitTestVisible="False">

                    <Image.RenderTransform>
                        <RotateTransform Angle="-25"/>
                    </Image.RenderTransform>
                </Image>

                <Image
                    Source="/Assets/huella.png"
                    Width="44"
                    Height="44"
                    Opacity="0.45"
                    RenderTransformOrigin="0.5,0.5"
                    IsHitTestVisible="False">

                    <Image.RenderTransform>
                        <RotateTransform Angle="15"/>
                    </Image.RenderTransform>
                </Image>

                <Image
                    Source="/Assets/huella.png"
                    Width="52"
                    Height="52"
                    Opacity="0.55"
                    Margin="0,36,0,0"
                    RenderTransformOrigin="0.5,0.5"
                    IsHitTestVisible="False">

                    <Image.RenderTransform>
                        <RotateTransform Angle="-15"/>
                    </Image.RenderTransform>
                </Image>

                <Image
                    Source="/Assets/huella.png"
                    Width="44"
                    Height="44"
                    Opacity="0.45"
                    RenderTransformOrigin="0.5,0.5"
                    IsHitTestVisible="False">

                    <Image.RenderTransform>
                        <RotateTransform Angle="20"/>
                    </Image.RenderTransform>
                </Image>

                <Image
                    Source="/Assets/huella.png"
                    Width="36"
                    Height="36"
                    Opacity="0.35"
                    Margin="0,32,0,0"
                    RenderTransformOrigin="0.5,0.5"
                    IsHitTestVisible="False">

                    <Image.RenderTransform>
                        <RotateTransform Angle="-20"/>
                    </Image.RenderTransform>
                </Image>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
