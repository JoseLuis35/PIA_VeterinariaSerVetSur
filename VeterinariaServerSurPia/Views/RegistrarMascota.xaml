<Page
    x:Class="VeterinariaServerSurPia.Views.RegistrarMascota"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="30">
        <StackPanel Spacing="20"
                    MaxWidth="650"
                    HorizontalAlignment="Left">

            <StackPanel Spacing="5">
                <TextBlock Text="Registro de Mascotas"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#004F8A"/>
                <TextBlock
                    Text="Registra una mascota y relaciónala con su propietario."
                    FontSize="14"
                    Foreground="Gray"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

                <StackPanel Spacing="15">
                    <TextBlock Text="Datos de la mascota"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#4A9949"/>

                    <TextBox x:Name="TxtIdMascota"
                             Header="ID de mascota (automático)"
                             IsReadOnly="True"
                             MaxLength="10"
                             PlaceholderText="Se genera automáticamente"/>

                    <TextBox x:Name="TxtNombreMascota"
                             Header="Nombre de la mascota"
                             PlaceholderText="Ej. Max"
                             MaxLength="50"
                             TextChanging="TxtNombreMascota_TextChanging"/>

                    <ComboBox x:Name="CmbEspecie"
                              Header="Especie"
                              PlaceholderText="Selecciona la especie"
                              HorizontalAlignment="Stretch">
                        <x:String>Perro</x:String>
                        <x:String>Gato</x:String>
                        <x:String>Ave</x:String>
                        <x:String>Conejo</x:String>
                        <x:String>Hámster</x:String>
                        <x:String>Reptil</x:String>
                        <x:String>Otra</x:String>
                    </ComboBox>

                    <TextBox x:Name="TxtRaza"
                             Header="Raza"
                             PlaceholderText="Ej. Labrador o Mestizo"
                             MaxLength="60"
                             TextChanging="TxtRaza_TextChanging"/>

                    <TextBox x:Name="TxtEdad"
                             Header="Edad (cantidad)"
                             PlaceholderText="Ej. 3"
                             MaxLength="3"
                             InputScope="Number"
                             TextChanging="TxtEdad_TextChanging"/>

                    <ComboBox x:Name="CmbUnidadEdad"
                              Header="Unidad de edad"
                              PlaceholderText="Selecciona una unidad"
                              HorizontalAlignment="Stretch">
                        <x:String>Meses</x:String>
                        <x:String>Años</x:String>
                    </ComboBox>

                    <ComboBox x:Name="CmbSexo"
                              Header="Sexo"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Selecciona el sexo">
                        <x:String>Macho</x:String>
                        <x:String>Hembra</x:String>
                    </ComboBox>

                    <TextBox x:Name="TxtPeso"
                             Header="Peso (kg)"
                             PlaceholderText="Ej. 15.5"
                             MaxLength="8"
                             InputScope="Number"
                             TextChanging="TxtPeso_TextChanging"/>

                    <ComboBox x:Name="CmbPropietario"
                              Header="Propietario"
                              PlaceholderText="Selecciona un cliente"
                              DisplayMemberPath="TextoMostrar"
                              HorizontalAlignment="Stretch"/>

                    <Button Content="Actualizar lista de clientes"
                            Click="BtnActualizarClientes_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="10" Margin="0,0,0,10">
                <Button x:Name="BtnGuardarMascota"
                        Content="Guardar mascota"
                        Click="BtnGuardarMascota_Click"
                        HorizontalAlignment="Stretch"
                        Height="45"
                        Background="#004F8A"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Button Content="Ir a Registrar Cliente"
                        Click="BtnIrClientes_Click"
                        HorizontalAlignment="Stretch"
                        Height="42"/>

                <TextBlock x:Name="TxtMensaje"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
