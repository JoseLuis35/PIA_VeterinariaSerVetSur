<Page
    x:Class="VeterinariaServerSurPia.Views.ConsultarHistorial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF13171A">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="20">

            <StackPanel Spacing="5">
                <TextBlock
                    Text="Consultar historial médico"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#FFF1F3F5"/>

                <TextBlock
                    Text="Consulta el expediente clínico y la cartilla médica de cada mascota."
                    Foreground="#FF909EA6"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Buscador -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Buscar mascota"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock
                        Text="Selecciona por ID o nombre"
                        Foreground="#FFD0D7DE"/>

                    <ComboBox
                        x:Name="MascotaCombo"
                        PlaceholderText="Selecciona una mascota"
                        DisplayMemberPath="TextoMostrar"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="MascotaCombo_SelectionChanged"/>

                    <TextBlock
                        x:Name="TxtEstado"
                        Text="Selecciona una mascota para consultar su expediente."
                        Foreground="#FF909EA6"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Perfil -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="14">
                    <TextBlock
                        Text="Información de la mascota"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <Grid ColumnSpacing="20" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="ID mascota" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtIdMascota" Text="—"
                                       Foreground="#FFF1F3F5"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Nombre" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtNombreMascota" Text="—"
                                       Foreground="#FFF1F3F5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="Especie" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtEspecie" Text="—"
                                       Foreground="#FFD0D7DE"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Raza" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtRaza" Text="—"
                                       Foreground="#FFD0D7DE"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="Peso registrado en ficha" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtPesoActual" Text="—"
                                       Foreground="#FFD0D7DE"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Propietario" Foreground="#FF909EA6"/>
                            <TextBlock x:Name="TxtPropietario" Text="—"
                                       Foreground="#FFD0D7DE"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Alergias y antecedentes -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Resumen médico"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock
                        Text="Alergias conocidas"
                        Foreground="#FF909EA6"/>

                    <TextBlock
                        x:Name="TxtAlergias"
                        Text="Sin información registrada."
                        Foreground="#FFD0D7DE"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Antecedentes médicos"
                        Foreground="#FF909EA6"/>

                    <TextBlock
                        x:Name="TxtAntecedentes"
                        Text="Sin información registrada."
                        Foreground="#FFD0D7DE"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Historial clínico -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Historial clínico"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"/>

                    <TextBlock
                        Text="Consultas ordenadas de la más reciente a la más antigua."
                        Foreground="#FF909EA6"
                        TextWrapping="Wrap"/>

                    <ListView
                        x:Name="HistorialListView"
                        SelectionMode="None"
                        MaxHeight="500"
                        Background="#FF263138">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="12" Spacing="6">
                                    <TextBlock
                                        Text="{Binding Titulo}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="#FFF1F3F5"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Detalle}"
                                        Foreground="#FFD0D7DE"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Cartilla médica -->
            <Border
                Background="#FF1D2328"
                BorderBrush="#FF2A333B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Cartilla de vacunas y desparasitación"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FFF1F3F5"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Fechas de aplicación y próximas fechas programadas."
                        Foreground="#FF909EA6"
                        TextWrapping="Wrap"/>

                    <ListView
                        x:Name="CartillaListView"
                        SelectionMode="None"
                        MaxHeight="400"
                        Background="#FF263138">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="12" Spacing="6">
                                    <TextBlock
                                        Text="{Binding Titulo}"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="#FFF1F3F5"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding Detalle}"
                                        Foreground="#FFD0D7DE"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
