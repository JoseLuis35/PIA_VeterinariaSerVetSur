<Page
    x:Class="VeterinariaServerSurPia.Views.ConsultarHistorial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFF6EA">

    <Page.Resources>

        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFF6E6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="26,24"/>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF8A7967"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF9A8065"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ValorCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF3D2B1B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CampoSeleccion" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="BorderBrush" Value="#FFF0D9BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF3D2B1B"/>
        </Style>

        <Style x:Key="ListaHistorial" TargetType="ListView">
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="BorderBrush" Value="#FFF3E5D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="SelectionMode" Value="None"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            MaxWidth="1000"
            HorizontalAlignment="Center"
            Spacing="20"
            Margin="24,24,24,32">

            <!-- ENCABEZADO -->
            <Border
                CornerRadius="26"
                Padding="26,22"
                BorderThickness="1"
                BorderBrush="#FFFFD9A6">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFF0DB" Offset="0"/>
                        <GradientStop Color="#FFFFD9A6" Offset="0.58"/>
                        <GradientStop Color="#FFFFB866" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="76"
                        Height="76"
                        CornerRadius="38"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFFFE4C2"
                        BorderThickness="2"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/logo_servetsur.png"
                            Width="62"
                            Height="62"
                            Stretch="Uniform"/>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <TextBlock
                            Text="CONSULTA VETERINARIA"
                            FontSize="11"
                            FontWeight="Bold"
                            CharacterSpacing="130"
                            Foreground="#FF9B5B1D"/>

                        <TextBlock
                            Text="Consultar historial médico"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#FF3A2412"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="Consulta el expediente clínico y la cartilla médica de cada mascota."
                            FontSize="13"
                            Foreground="#FF76502E"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <Image
                        Grid.Column="2"
                        Source="/Assets/huella.png"
                        Width="48"
                        Height="48"
                        Opacity="0.45"
                        Stretch="Uniform"
                        VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- BUSCADOR -->
            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB"
                            VerticalAlignment="Center">

                            <FontIcon
                                Glyph="&#xE721;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Buscar mascota"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Selecciona por ID o nombre para consultar su expediente."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <ComboBox
                        x:Name="MascotaCombo"
                        Style="{StaticResource CampoSeleccion}"
                        PlaceholderText="Selecciona una mascota"
                        DisplayMemberPath="TextoMostrar"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="MascotaCombo_SelectionChanged"/>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,11">

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE946;"
                                Foreground="#FFF28C28"
                                FontSize="17"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="TxtEstado"
                                Grid.Column="1"
                                Text="Selecciona una mascota para consultar su expediente."
                                Foreground="#FF80694F"
                                FontSize="13"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- INFORMACIÓN DE LA MASCOTA -->
            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE77B;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Información de la mascota"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Datos generales registrados en el sistema."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <Grid RowSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Text="ID DE MASCOTA" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtIdMascota" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="NOMBRE" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtNombreMascota" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="ESPECIE" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtEspecie" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="RAZA" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtRaza" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Text="PESO REGISTRADO" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtPesoActual" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Text="PROPIETARIO" Style="{StaticResource EtiquetaCampo}"/>
                            <TextBlock x:Name="TxtPropietario" Text="—" Style="{StaticResource ValorCampo}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RESUMEN MÉDICO -->
            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE8D4;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Resumen médico"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Información importante para el seguimiento clínico."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    Foreground="#FFF28C28"
                                    FontSize="17"/>

                                <TextBlock
                                    Text="Alergias conocidas"
                                    FontWeight="SemiBold"
                                    Foreground="#FF684A2E"/>
                            </StackPanel>

                            <TextBlock
                                x:Name="TxtAlergias"
                                Text="Sin información registrada."
                                Foreground="#FF5A4E42"
                                TextWrapping="Wrap"
                                FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE8EC;"
                                    Foreground="#FFF28C28"
                                    FontSize="17"/>

                                <TextBlock
                                    Text="Antecedentes médicos"
                                    FontWeight="SemiBold"
                                    Foreground="#FF684A2E"/>
                            </StackPanel>

                            <TextBlock
                                x:Name="TxtAntecedentes"
                                Text="Sin información registrada."
                                Foreground="#FF5A4E42"
                                TextWrapping="Wrap"
                                FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- HISTORIAL CLÍNICO -->
            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Historial clínico"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Consultas ordenadas de la más reciente a la más antigua."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="HistorialListView"
                        Style="{StaticResource ListaHistorial}"
                        MaxHeight="500">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FFF3E5D3"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="2,4">

                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="{Binding Titulo}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#FFB96820"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding Detalle}"
                                            Foreground="#FF5A4E42"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            LineHeight="21"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- CARTILLA MÉDICA -->
            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xEAD2;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Cartilla médica"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Vacunas, desparasitaciones y próximas fechas programadas."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="CartillaListView"
                        Style="{StaticResource ListaHistorial}"
                        MaxHeight="400">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FFF3E5D3"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="2,4">

                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="{Binding Titulo}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#FFB96820"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding Detalle}"
                                            Foreground="#FF5A4E42"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            LineHeight="21"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- PIE -->
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="7"
                Margin="0,4,0,0">

                <Image
                    Source="/Assets/huella.png"
                    Width="30"
                    Height="30"
                    Opacity="0.45"/>

                <TextBlock
                    Text="SERVETSUR MTY · CUIDANDO SU SALUD"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="100"
                    Foreground="#FFB49A7C"
                    HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
