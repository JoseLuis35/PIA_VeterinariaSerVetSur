<Page
    x:Class="VeterinariaServerSurPia.Views.ExportarPDF"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFF6EA"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Loaded="ExportarPDF_Loaded">

    <Page.Resources>

        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFF6E6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="26,24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF8A7967"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#FFF28C28"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Background" Value="#FFFFF1DD"/>
            <Setter Property="Foreground" Value="#FF9A581B"/>
            <Setter Property="BorderBrush" Value="#FFFFD9A6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CampoSeleccion" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="BorderBrush" Value="#FFF0D9BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF3D2B1B"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="OpcionExportacion" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF5A4E42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

    </Page.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="20"
            Margin="24,20,24,30">

            <Border
                CornerRadius="26"
                Padding="26,22"
                BorderThickness="1"
                BorderBrush="#FFFFD9A6"
                HorizontalAlignment="Stretch">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFF0DB" Offset="0"/>
                        <GradientStop Color="#FFFFD9A6" Offset="0.58"/>
                        <GradientStop Color="#FFFFB866" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="76"
                        Height="76"
                        CornerRadius="38"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFFFE4C2"
                        BorderThickness="2"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/logo_servetsur.png"
                            Width="62"
                            Height="62"
                            Stretch="Uniform"/>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <TextBlock
                            Text="GESTIÓN DE DOCUMENTOS"
                            FontSize="11"
                            FontWeight="Bold"
                            CharacterSpacing="130"
                            Foreground="#FF9B5B1D"/>

                        <TextBlock
                            Text="Exportar reportes PDF"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#FF3A2412"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="Genera reportes de la veterinaria y expedientes médicos individuales."
                            FontSize="13"
                            Foreground="#FF76502E"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <Image
                        Grid.Column="2"
                        Source="/Assets/huella.png"
                        Width="48"
                        Height="48"
                        Opacity="0.45"
                        Stretch="Uniform"
                        VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Información que se incluirá"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Selecciona las secciones que deseas incorporar al reporte general."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="5">

                            <CheckBox
                                x:Name="ChkClientes"
                                Content="Clientes y estado de actividad"
                                IsChecked="True"
                                Style="{StaticResource OpcionExportacion}"/>

                            <CheckBox
                                x:Name="ChkMascotas"
                                Content="Mascotas y datos de sus propietarios"
                                IsChecked="True"
                                Style="{StaticResource OpcionExportacion}"/>

                            <CheckBox
                                x:Name="ChkCitas"
                                Content="Citas registradas"
                                IsChecked="True"
                                Style="{StaticResource OpcionExportacion}"/>

                            <CheckBox
                                x:Name="ChkHistorial"
                                Content="Historial clínico, peso, alergias y antecedentes"
                                IsChecked="True"
                                Style="{StaticResource OpcionExportacion}"/>

                            <CheckBox
                                x:Name="ChkCartilla"
                                Content="Cartilla de vacunas y desparasitación"
                                IsChecked="True"
                                Style="{StaticResource OpcionExportacion}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="Puedes seleccionar una o varias secciones. El reporte incluirá únicamente las opciones marcadas."
                        Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE77B;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Expediente individual"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Genera un documento con la información médica de una mascota y su propietario."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="10">

                            <TextBlock
                                Text="Selecciona la mascota"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FF80694F"/>

                            <ComboBox
                                x:Name="MascotaCombo"
                                Style="{StaticResource CampoSeleccion}"
                                PlaceholderText="Selecciona una mascota"
                                DisplayMemberPath="TextoMostrar"
                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="BtnExportarExpediente"
                        Style="{StaticResource BotonSecundario}"
                        Click="BtnExportarExpediente_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="9"
                            HorizontalAlignment="Center">

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="17"/>

                            <TextBlock
                                Text="Exportar expediente de la mascota"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TarjetaSeccion}">
                <StackPanel Spacing="16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#FFFFF0DB">

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="20"
                                Foreground="#FFF28C28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Text="Reporte general"
                                Style="{StaticResource TituloSeccion}"/>

                            <TextBlock
                                Text="Concentra la información seleccionada de la veterinaria en un solo documento PDF."
                                Style="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="#FFFFF8EF"
                        BorderBrush="#FFF3E5D3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        HorizontalAlignment="Stretch">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <FontIcon
                                Glyph="&#xE8A5;"
                                FontSize="24"
                                Foreground="#FFF28C28"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="3">

                                <TextBlock
                                    Text="Documento PDF"
                                    FontWeight="SemiBold"
                                    Foreground="#FF684A2E"/>

                                <TextBlock
                                    Text="Elige las secciones anteriores para definir su contenido."
                                    FontSize="12"
                                    Foreground="#FF8A7967"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="BtnExportarTodo"
                        Style="{StaticResource BotonPrincipal}"
                        Click="BtnExportarTodo_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="9"
                            HorizontalAlignment="Center">

                            <FontIcon
                                Glyph="&#xE74E;"
                                FontSize="18"/>

                            <TextBlock
                                Text="Exportar reporte general a PDF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border
                Background="#FFFFF1DD"
                BorderBrush="#FFFFD9A6"
                BorderThickness="1"
                CornerRadius="16"
                Padding="17"
                HorizontalAlignment="Stretch">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="#FFFFFFFF">

                        <FontIcon
                            Glyph="&#xE946;"
                            FontSize="18"
                            Foreground="#FFF28C28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            Text="Estado de exportación"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#FF9A581B"/>

                        <TextBlock
                            x:Name="TxtEstado"
                            Text="Cargando información de la veterinaria..."
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FF684A2E"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="7"
                Margin="0,4,0,0">

                <Image
                    Source="/Assets/huella.png"
                    Width="30"
                    Height="30"
                    Opacity="0.45"/>

                <TextBlock
                    Text="SERVETSUR MTY · CUIDANDO SU SALUD"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="100"
                    Foreground="#FFB49A7C"
                    HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
