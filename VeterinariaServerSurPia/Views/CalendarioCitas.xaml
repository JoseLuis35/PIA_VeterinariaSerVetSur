<Page
    x:Class="VeterinariaServerSurPia.Views.CalendarioCitas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="#FFFFF6EA"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>

        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFF6E6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1F140A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF8A7967"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#FFF28C28"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="Background" Value="#FFFFF1DD"/>
            <Setter Property="Foreground" Value="#FF9A581B"/>
            <Setter Property="BorderBrush" Value="#FFFFD9A6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CampoSoloLectura" TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="BorderBrush" Value="#FFF0D9BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF3D2B1B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF9A8065"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ListaCitas" TargetType="ListView">
            <Setter Property="Background" Value="#FFFFF8EF"/>
            <Setter Property="BorderBrush" Value="#FFF3E5D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

    </Page.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Auto"
            HorizontalAlignment="Stretch">

            <StackPanel
                HorizontalAlignment="Stretch"
                Spacing="18"
                Margin="20,18,20,26">

                <Border
                    CornerRadius="26"
                    Padding="26,22"
                    BorderThickness="1"
                    BorderBrush="#FFFFD9A6"
                    HorizontalAlignment="Stretch">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFF0DB" Offset="0"/>
                            <GradientStop Color="#FFFFD9A6" Offset="0.58"/>
                            <GradientStop Color="#FFFFB866" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid ColumnSpacing="18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="76"
                            Height="76"
                            CornerRadius="38"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFFFE4C2"
                            BorderThickness="2"
                            VerticalAlignment="Center">

                            <Image
                                Source="/Assets/logo_servetsur.png"
                                Width="62"
                                Height="62"
                                Stretch="Uniform"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="5">

                            <TextBlock
                                Text="ORGANIZACIÓN VETERINARIA"
                                FontSize="11"
                                FontWeight="Bold"
                                CharacterSpacing="130"
                                Foreground="#FF9B5B1D"/>

                            <TextBlock
                                Text="Calendario de citas"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#FF3A2412"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Organiza las citas y consulta la agenda de cada día."
                                FontSize="13"
                                Foreground="#FF76502E"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <Image
                            Grid.Column="2"
                            Source="/Assets/huella.png"
                            Width="48"
                            Height="48"
                            Opacity="0.45"
                            Stretch="Uniform"
                            VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <Grid
                    ColumnSpacing="14"
                    HorizontalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFF6E6CF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="20"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="12">

                            <Border
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#FFFFF0DB"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE787;"
                                    FontSize="20"
                                    Foreground="#FFF28C28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="Citas del día"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#FF80694F"/>

                            <TextBlock
                                x:Name="TxtTotalDia"
                                Text="0"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="#FFB96820"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFF6E6CF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="20"
                        HorizontalAlignment="Stretch">

                        <StackPanel Spacing="12">

                            <Border
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#FFFFF0DB"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE787;"
                                    FontSize="20"
                                    Foreground="#FFF28C28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="Citas del mes seleccionado"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#FF80694F"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="TxtTotalMes"
                                Text="0"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="#FFB96820"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Style="{StaticResource TarjetaSeccion}">

                    <StackPanel
                        Spacing="16"
                        HorizontalAlignment="Stretch">

                        <Grid ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FFFFF0DB">

                                <FontIcon
                                    Glyph="&#xE787;"
                                    FontSize="20"
                                    Foreground="#FFF28C28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                                <TextBlock
                                    Text="Selecciona una fecha"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Elige un día para consultar las citas programadas."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="9"
                            VerticalAlignment="Center">

                            <Border
                                Width="18"
                                Height="18"
                                CornerRadius="5"
                                Background="#FFF28C28"/>

                            <TextBlock
                                Text="Día con citas registradas"
                                FontSize="12"
                                Foreground="#FF80694F"
                                VerticalAlignment="Center"/>

                            <Border
                                Width="18"
                                Height="18"
                                CornerRadius="5"
                                Background="#FFFFF8EF"
                                BorderBrush="#FFE8D7C2"
                                BorderThickness="1"
                                Margin="14,0,0,0"/>

                            <TextBlock
                                Text="Día sin citas"
                                FontSize="12"
                                Foreground="#FF80694F"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border
                            Background="#FFFFF8EF"
                            BorderBrush="#FFF3E5D3"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="10"
                            HorizontalAlignment="Stretch">

                            <CalendarView
                                x:Name="Calendario"
                                SelectionMode="Single"
                                IsTodayHighlighted="True"
                                FirstDayOfWeek="Monday"
                                SelectedDatesChanged="Calendario_SelectedDatesChanged"
                                CalendarViewDayItemChanging="Calendario_DayItemChanging"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        </Border>

                        <Grid ColumnSpacing="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Style="{StaticResource BotonSecundario}"
                                Click="BtnIrHoy_Click">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">

                                    <FontIcon
                                        Glyph="&#xE8D4;"
                                        FontSize="16"/>

                                    <TextBlock Text="Ir a hoy"/>
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource BotonPrincipal}"
                                Click="BtnActualizar_Click">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">

                                    <FontIcon
                                        Glyph="&#xE72C;"
                                        FontSize="16"/>

                                    <TextBlock Text="Actualizar agenda"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource TarjetaSeccion}">

                    <StackPanel
                        Spacing="14"
                        HorizontalAlignment="Stretch">

                        <Grid ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FFFFF0DB">

                                <FontIcon
                                    Glyph="&#xE8A5;"
                                    FontSize="20"
                                    Foreground="#FFF28C28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                                <TextBlock
                                    x:Name="TxtFechaSeleccionada"
                                    Text="Agenda del día"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Citas programadas para la fecha seleccionada."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="#FFFFF8EF"
                            BorderBrush="#FFF3E5D3"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11">

                            <Grid ColumnSpacing="10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Glyph="&#xE946;"
                                    Foreground="#FFF28C28"
                                    FontSize="17"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="TxtMensajeAgenda"
                                    Grid.Column="1"
                                    Text="Selecciona una fecha del calendario."
                                    Foreground="#FF80694F"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListView
                            x:Name="CitasListView"
                            Style="{StaticResource ListaCitas}"
                            MaxHeight="450"
                            SelectionMode="Single"
                            SelectionChanged="CitasListView_SelectionChanged"
                            HorizontalAlignment="Stretch">

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFF3E5D3"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="2,4"
                                        HorizontalAlignment="Stretch">

                                        <StackPanel Spacing="8">

                                            <TextBlock
                                                Text="{Binding Titulo}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="#FFB96820"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Detalle}"
                                                FontSize="13"
                                                Foreground="#FF5A4E42"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource TarjetaSeccion}">

                    <StackPanel
                        Spacing="16"
                        HorizontalAlignment="Stretch">

                        <Grid ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FFFFF0DB">

                                <FontIcon
                                    Glyph="&#xE70F;"
                                    FontSize="20"
                                    Foreground="#FFF28C28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                                <TextBlock
                                    Text="Detalles de la cita"
                                    Style="{StaticResource TituloSeccion}"/>

                                <TextBlock
                                    Text="Selecciona una cita de la agenda para consultar su información."
                                    Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="#FFFFF8EF"
                            BorderBrush="#FFF3E5D3"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            HorizontalAlignment="Stretch">

                            <Grid
                                ColumnSpacing="18"
                                RowSpacing="13">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="ID DE LA CITA"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtIDCita"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="HORA"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtHora"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="MASCOTA"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtMascota"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="PROPIETARIO"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtPropietario"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">

                                    <TextBlock
                                        Text="SERVICIO"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtServicio"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="4">

                                    <TextBlock
                                        Text="OBSERVACIONES"
                                        Style="{StaticResource EtiquetaCampo}"/>

                                    <TextBox
                                        x:Name="TxtObservaciones"
                                        Style="{StaticResource CampoSoloLectura}"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="85"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button
                            Style="{StaticResource BotonPrincipal}"
                            Click="BtnAdministrar_Click"
                            HorizontalAlignment="Stretch">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="9"
                                HorizontalAlignment="Center">

                                <FontIcon
                                    Glyph="&#xE70F;"
                                    FontSize="17"/>

                                <TextBlock Text="Ir a modificar / eliminar"/>
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Text="Para administrar una cita, primero selecciónala en la agenda."
                            Style="{StaticResource TextoSecundario}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="7"
                    Margin="0,4,0,0">

                    <Image
                        Source="/Assets/huella.png"
                        Width="30"
                        Height="30"
                        Opacity="0.45"/>

                    <TextBlock
                        Text="SERVETSUR MTY · CUIDANDO SU SALUD"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="100"
                        Foreground="#FFB49A7C"
                        HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
