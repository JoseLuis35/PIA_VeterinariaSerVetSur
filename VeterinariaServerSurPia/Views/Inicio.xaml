<Page
    x:Class="VeterinariaServerSurPia.Views.Inicio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFF7F8FA">

    <Page.Resources>
 
        <Style x:Key="TarjetaInicio" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF292D32"/>
            <Setter Property="BorderBrush" Value="#FFFFD7B7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="IconoInicio" TargetType="FontIcon">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#FFF28C28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TituloTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF292D32"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DescripcionTarjeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF747B83"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Grid>

        <Image
            Source="/Assets/Fondo.png"
            Stretch="UniformToFill"
            Opacity="0.75"
            IsHitTestVisible="False"/>

        <Grid
            Background="#99FFFFFF"
            IsHitTestVisible="False"/>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="30"
                Spacing="22"
                HorizontalAlignment="Stretch">

                <Border
                    Background="#FFF28C28"
                    CornerRadius="20"
                    Padding="25">

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="White"
                            CornerRadius="16"
                            Width="78"
                            Height="78"
                            VerticalAlignment="Center">

                            <Image
                                Source="/Assets/logo_servetsur.png"
                                Width="65"
                                Height="65"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">

                            <TextBlock
                                Text="Veterinaria ServerSurPia"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="White"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Sistema de gestión veterinaria"
                                FontSize="14"
                                Foreground="#FFFFF5EA"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Cuidamos lo que más quieres"
                                FontSize="13"
                                Foreground="#FFFFF5EA"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="¡Bienvenido!"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#FF252A30"/>

                    <TextBlock
                        Text="Gestiona toda la información de tu veterinaria desde un solo lugar."
                        FontSize="15"
                        Foreground="#FF606872"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock
                        Text="Accesos principales"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#FF30353B"/>

                    <TextBlock
                        Text="Selecciona el módulo que deseas utilizar"
                        FontSize="13"
                        Foreground="#FF707780"/>
                </StackPanel>

                <Grid
                    ColumnSpacing="16"
                    RowSpacing="16"
                    HorizontalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnClientes_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE716;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Clientes"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Registrar y administrar propietarios"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnMascotas_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE8D4;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Mascotas"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Registrar y consultar mascotas"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnCitas_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE787;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Citas"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Programar y administrar citas"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnHistorial_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE95E;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Historial médico"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Consultas clínicas y cartillas"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnBusqueda_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE721;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Buscar registros"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Localizar información registrada"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnModificar_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE70F;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Modificar registros"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Actualizar o eliminar información"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnCalendario_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE163;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Calendario"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Visualizar citas programadas"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource TarjetaInicio}"
                        Click="BtnPDF_Click">

                        <StackPanel
                            Padding="20"
                            Spacing="10"
                            VerticalAlignment="Center">

                            <Border
                                Background="#FFFFF0E2"
                                CornerRadius="12"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Left">

                                <FontIcon
                                    Glyph="&#xE8A5;"
                                    Style="{StaticResource IconoInicio}"/>
                            </Border>

                            <TextBlock
                                Text="Exportar PDF"
                                Style="{StaticResource TituloTarjeta}"/>

                            <TextBlock
                                Text="Generar reportes y expedientes"
                                Style="{StaticResource DescripcionTarjeta}"/>
                        </StackPanel>
                    </Button>

                </Grid>
                
                <Border
                    Background="#FFFFF0E2"
                    CornerRadius="12"
                    Padding="16"
                    HorizontalAlignment="Stretch">

                    <TextBlock
                        Text="VeterinariaServerSurPia  •  Cuidando la salud de tus mascotas"
                        Foreground="#FF99521B"
                        FontSize="13"
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
